# Copy to .env for local development. Never commit a real .env file.

# "mock" (default) needs nothing below this line.
# "dynamodb" requires AWS_REGION, DYNAMODB_TABLE_NAME, and an IAM role
# (or locally configured AWS credentials) with read access to that table.
DATA_SOURCE=mock

# Comma-separated. This default is for local development only -- issue a
# real key (and rotate it) before this is ever reachable outside localhost.
API_KEYS=dev-local-key-change-me

CORS_ALLOW_ORIGIN=http://localhost:8000
RATE_LIMIT=60/minute
LOG_LEVEL=INFO

AWS_REGION=
DYNAMODB_TABLE_NAME=

# Static IAM user key pair, used by DynamoDBDataSource and
# scripts/check_aws_connection.py. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# "development" (default) exposes /docs, /redoc, /openapi.json.
# "production" disables all three -- set before any non-local deployment.
ENVIRONMENT=development

# Set True only once a specific reverse proxy/load balancer is confirmed to
# sit directly in front of this app as exactly one hop -- see
# app/security.py's get_client_ip() for what this changes.
TRUST_PROXY_HEADERS=false

# How long list_branches() results are cached in-process before the data
# source is re-queried. Default matches a healthy margin under the
# dashboard's 5-minute poll cadence.
BRANCHES_CACHE_TTL_SECONDS=60
