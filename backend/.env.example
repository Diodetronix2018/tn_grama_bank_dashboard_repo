# Copy to .env for local development. Never commit a real .env file.

# "mock" (default) needs nothing below this line.
# "dynamodb" requires AWS_REGION, DYNAMODB_TABLE_NAME, and an IAM role
# (or locally configured AWS credentials) with read access to that table.
DATA_SOURCE=mock

CORS_ALLOW_ORIGIN=http://localhost:8000
RATE_LIMIT=60/minute
LOG_LEVEL=INFO

AWS_REGION=
DYNAMODB_TABLE_NAME=

# Static IAM user key pair, used by DynamoDBDataSource and
# scripts/check_aws_connection.py. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# "development" (default) exposes /docs, /redoc, /openapi.json.
# "production" disables all three -- set before any non-local deployment.
ENVIRONMENT=development

# Set True only once a specific reverse proxy/load balancer is confirmed to
# sit directly in front of this app as exactly one hop -- see
# app/security.py's get_client_ip() for what this changes.
TRUST_PROXY_HEADERS=false

# How long list_branches() results are cached in-process before the data
# source is re-queried. Default matches a healthy margin under the
# dashboard's 5-minute poll cadence.
BRANCHES_CACHE_TTL_SECONDS=60

# Cognito identity provider (login/logout). Empty by default -- local dev
# and the test suite never touch Cognito. See IMPLEMENTATION.md for what to
# request from whoever provisions the User Pool.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=

# HMAC key for our own session cookie -- NOT a Cognito credential. Must be a
# long random value before ENVIRONMENT=production (startup fails fast
# otherwise). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=dev-local-session-secret-change-me

# How long a session cookie is valid. Short on purpose -- see
# app/auth/session.py for why there's no server-side revocation.
SESSION_TTL_MINUTES=30

# Tighter than the general RATE_LIMIT -- the one endpoint brute-forcing
# actually gains anything from.
LOGIN_RATE_LIMIT=5/minute

# Demo-only shortcut for showing the dashboard before Cognito is provisioned
# (see app/routers/auth.py's _demo_login). Leave DEMO_MODE=false everywhere
# except a throwaway demo deployment -- when true, DEMO_USERNAME/PASSWORD
# log in without touching Cognito at all.
DEMO_MODE=false
DEMO_USERNAME=
DEMO_PASSWORD=

# Serves tngb-dashboard's static files from this same FastAPI app, so a demo
# can be deployed as a single service. See main.py.
SERVE_DASHBOARD_STATIC=false
