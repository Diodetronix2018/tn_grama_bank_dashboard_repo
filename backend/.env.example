# Copy to .env for local development. Never commit a real .env file.

# "mock" (default) needs nothing below this line.
# "dynamodb" requires AWS_REGION, DYNAMODB_TABLE_NAME, and an IAM role
# (or locally configured AWS credentials) with read access to that table.
DATA_SOURCE=mock

# Comma-separated. This default is for local development only -- issue a
# real key (and rotate it) before this is ever reachable outside localhost.
API_KEYS=dev-local-key-change-me

CORS_ALLOW_ORIGIN=http://localhost:8000
RATE_LIMIT=60/minute
LOG_LEVEL=INFO

AWS_REGION=
DYNAMODB_TABLE_NAME=
